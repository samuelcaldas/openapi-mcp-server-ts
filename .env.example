# ==============================================================================
# OpenAPI MCP Server Configuration
# All credentials here are fictitious placeholders. Never commit actual secrets.
# ==============================================================================

# Server Identity & Target OpenAPI Specification
API_NAME=petstore-mcp-server
API_BASE_URL=https://api.example.com/v1
API_SPEC_URL=https://api.example.com/v1/openapi.json
# API_SPEC_PATH=/path/to/local/openapi.yaml
# ADDITIONAL_SPECS=/path/to/spec2.json,/path/to/spec3.yaml
# INCLUDE_TAGS=pets,orders
# EXCLUDE_TAGS=admin,internal
VALIDATE_OUTPUT=true

# Server Transport & Networking
# Transport: stdio | http (SSE has been discontinued in favor of Streamable HTTP at /mcp)
TRANSPORT=stdio
HOST=127.0.0.1
PORT=8000
ALLOW_INSECURE_HTTP=false
ALLOW_PRIVATE_NETWORKS=false
# ALLOWED_SPEC_DIRS=/path/to/specs

# Inbound Authentication (for remote Streamable HTTP /mcp)
# Modes: none | bearer | oauth (mutually exclusive)
# Note: 'none' is strictly forbidden on non-loopback hosts.
INBOUND_AUTH_TYPE=none

# Inbound Bearer Token (constant-time verification)
# Provide via environment variable or mounted secret file (never CLI arguments)
# INBOUND_BEARER_TOKEN=example-secure-random-token-here
# INBOUND_BEARER_TOKEN_FILE=/run/secrets/inbound_bearer_token

# Inbound OAuth 2.1 (JWT / JWKS verification)
# INBOUND_OAUTH_ISSUER_URL=https://auth.example.com
# INBOUND_OAUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# INBOUND_OAUTH_AUDIENCE=https://mcp.dev.timoteo.mg.gov.br/mcp
# INBOUND_OAUTH_RESOURCE_SERVER_URL=https://mcp.dev.timoteo.mg.gov.br/mcp
# INBOUND_OAUTH_SCOPES=api:read,api:write

# Delegation Mode to Destination API
# Modes: service | user
# 'service': uses configured shared credentials below for outbound API calls.
# 'user': RFC 8693 OAuth 2.0 Token Exchange (exchanges incoming user MCP token for target API token).
DELEGATION_MODE=service

# RFC 8693 Token Exchange (Required when DELEGATION_MODE=user)
# TOKEN_EXCHANGE_URL=https://auth.example.com/oauth/token
# TOKEN_EXCHANGE_AUDIENCE=https://api.example.com
# TOKEN_EXCHANGE_SCOPES=api:user:read,api:user:write
# TOKEN_EXCHANGE_CLIENT_ID=mcp-server-client
# TOKEN_EXCHANGE_CLIENT_SECRET=example-client-secret
# TOKEN_EXCHANGE_CLIENT_SECRET_FILE=/run/secrets/token_exchange_client_secret

# Outbound API Authentication (Used in service delegation mode)
AUTH_TYPE=none
# AUTH_TOKEN=example-outbound-token
# AUTH_USERNAME=service-user
# AUTH_PASSWORD=service-password
# AUTH_API_KEY=example-api-key
# AUTH_API_KEY_NAME=x-api-key
# AUTH_API_KEY_IN=header
# AUTH_COGNITO_CLIENT_ID=example-cognito-client-id
# AUTH_COGNITO_USERNAME=example-user
# AUTH_COGNITO_PASSWORD=example-cognito-password
# AUTH_COGNITO_DOMAIN=example-pool.auth.us-east-1.amazoncognito.com
# AUTH_COGNITO_SCOPES=api/read
# AUTH_COGNITO_REGION=us-east-1

# Reverse Proxy & Security Headers
# TRUST_PROXY=true (or specific proxy IP, e.g. 10.250.50.60)
# ALLOWED_HOSTS=mcp.dev.timoteo.mg.gov.br,localhost
# ALLOWED_ORIGINS=https://claude.ai,https://mcp.dev.timoteo.mg.gov.br
